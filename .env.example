# Variáveis de ambiente — NÃO commite o arquivo .env com valores reais!
# Copie este arquivo para .env (na raiz do repositório) e preencha os valores.
#
# Os docker-compose sobrescrevem POSTGRES_HOST e REDIS_URL com os nomes dos
# serviços (db, redis). Os valores abaixo valem para rodar o backend no host.

# ── Aplicação ──────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
# Em produção: no mínimo 32 caracteres aleatórios
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production
LOG_LEVEL=INFO
# Origens confiáveis (CORS e checagem de Origin no refresh/logout), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost
# URL pública do frontend, usada nos links dos e-mails
FRONTEND_URL=http://localhost:5173

# ── Autenticação ───────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
# Cookie do refresh token só via HTTPS (navegadores aceitam em http://localhost)
REFRESH_COOKIE_SECURE=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=apan
POSTGRES_PASSWORD=apan
POSTGRES_DB=apan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: URL completa (ignora as variáveis POSTGRES_* acima)
# DATABASE_URL=postgresql+asyncpg://apan:apan@localhost:5432/apan

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── E-mail (SMTP) ──────────────────────────────────────────────────────────
# No compose de desenvolvimento, SMTP_HOST aponta para o Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
MAIL_FROM=APAN <nao-responda@localhost>
